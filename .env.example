# Copy to .env (git-ignored) and fill in YOUR keys. Never share keys in messages, issues or commits.
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# Setting this to 1 is your explicit approval to spend on the 3 smoke calls and the 90-call run (EUR 5 hard cap enforced in code).
FASHIONGRAPH_APPROVED_SPEND=
# Free-tier configuration only (models.free.json): set to 1 ONLY after confirming that the Gemini key belongs to a Google Cloud project
# WITHOUT a billing account and that your Groq organisation is on the Free plan (not Developer). Nothing is billed in free mode.
FASHIONGRAPH_FREE_TIER_CONFIRMED=
